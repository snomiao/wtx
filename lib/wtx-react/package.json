{
  "name": "@snomiao/wtx-react",
  "version": "0.0.3",
  "description": "React xterm.js terminal with WS auto-reconnect, heartbeat, and graceful session-ended handling — pairs with @snomiao/wtx",
  "keywords": [
    "pty",
    "react",
    "terminal",
    "websocket",
    "xterm"
  ],
  "homepage": "https://github.com/snomiao/wtx#readme",
  "bugs": "https://github.com/snomiao/wtx/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snomiao/wtx.git",
    "directory": "lib/wtx-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
